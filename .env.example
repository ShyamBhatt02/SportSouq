# Base path when deploying under a sub-folder (e.g. /SportSouq/dist/). Defaults to "/".
VITE_BASE_PATH=/
# When "false", the Axios client calls VITE_API_BASE_URL instead of the in-browser mock API.
VITE_USE_MOCK_API=true
# Future REST backend (database: sportsouq). Unused while the mock API is enabled.
VITE_API_BASE_URL=http://localhost/sportsouq-api
# Public site URL used for canonical / Open Graph tags.
VITE_SITE_URL=http://localhost:5173
